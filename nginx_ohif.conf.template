server {
    listen 80;
    server_name _;
    # Redirect all HTTP to HTTPS
    return 301 https://$host$request_uri;
}

upstream pacs_web_upstream {
    server pacs-web:3001;
    keepalive 32;
}

upstream orthanc_upstream {
    server orthanc:8042;
    keepalive 64;
}

server {
    listen 443 ssl http2;
    server_name _;

    ssl_certificate     /etc/nginx/ssl/live/${DOMAIN_NAME}/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/live/${DOMAIN_NAME}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    client_max_body_size 500M;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        image/svg+xml
        application/wasm;

    # Serve the custom logo directly (high priority)
    location = /logo.png {
        alias /usr/share/nginx/html/logo.png;
        add_header Cache-Control "public, max-age=2592000, immutable";
        access_log off;
    }


    # Required for OHIF v3 SharedArrayBuffer / volume rendering
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Embedder-Policy "require-corp" always;
    add_header Cross-Origin-Resource-Policy "cross-origin" always;

    # Next.js Frontend
    location / {
        proxy_pass http://pacs_web_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # SSE support for live notifications
    location /api/events {
        proxy_pass http://pacs_web_upstream;
        proxy_set_header Host $host;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding off;
        proxy_read_timeout 3600s;
    }

    # OHIF shell/assets from Orthanc. Keep this separate so the browser can
    # reuse the large JS/CSS bundles across repeated viewer opens.
    location /orthanc/ohif/ {
        proxy_pass http://orthanc_upstream/ohif/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Authorization "Basic ${ORTHANC_AUTH_BASE64}";
        proxy_set_header X-Forwarded-Host $host;
        expires 10m;
        add_header Cache-Control "public, max-age=600, stale-while-revalidate=86400" always;
    }

    # OHIF DICOMweb traffic resolves to /orthanc/dicom-web because the viewer
    # itself is mounted under /orthanc/ohif. Stream frames directly instead of
    # buffering them to nginx temp files.
    location /orthanc/dicom-web/ {
        proxy_pass http://orthanc_upstream/dicom-web/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Authorization "Basic ${ORTHANC_AUTH_BASE64}";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_max_temp_file_size 0;
        proxy_read_timeout 600s;
    }

    # Orthanc — Explorer, REST API
    location /orthanc/ {
        proxy_pass http://orthanc_upstream/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Authorization "Basic ${ORTHANC_AUTH_BASE64}";
        proxy_set_header X-Forwarded-Host $host;
    }

    # DICOMweb — required by OHIF v3
    location /dicom-web/ {
        proxy_pass http://orthanc_upstream/dicom-web/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Authorization "Basic ${ORTHANC_AUTH_BASE64}";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_max_temp_file_size 0;
        proxy_read_timeout 600s;
    }

    # WADO-URI fallback
    location /wado {
        proxy_pass http://orthanc_upstream/wado;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header Authorization "Basic ${ORTHANC_AUTH_BASE64}";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_max_temp_file_size 0;
        proxy_read_timeout 600s;
    }

    location /orthanc/wado {
        proxy_pass http://orthanc_upstream/wado;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header Authorization "Basic ${ORTHANC_AUTH_BASE64}";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_max_temp_file_size 0;
        proxy_read_timeout 600s;
    }
}

