generator client {
  provider      = "prisma-client-js"
  output        = "../app/generated/prisma"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String            @id @default(cuid())
  name          String?
  email         String?           @unique
  password      String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  roleId        String?
  accounts      Account[]
  reports       RadiologyReport[] @relation("DoctorReports")
  sessions      Session[]
  role          Role?             @relation(fields: [roleId], references: [id])
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  users       User[]
  permissions Permission[] @relation("PermissionToRole")
}

model Permission {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  roles     Role[]   @relation("PermissionToRole")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AiResult {
  studyInstanceUid String   @id
  modality         String
  conclusion       String
  findings         Json
  isUrgent         Boolean  @default(false)
  heatmapPath      String?
  heatmapBase64    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SatuSehatIntegration {
  accessionNumber  String    @id
  studyInstanceUid String?
  satusehatId      String?
  patientNik       String?
  status           String    @default("PENDING")
  error            String?
  bundleResponse   Json?
  syncedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model SatuSehatWebhookLog {
  id               String   @id @default(cuid())
  studyInstanceUid String?
  patientName      String?
  status           String
  message          String?
  errorDetail      Json?
  rawPayload       Json?
  createdAt        DateTime @default(now())
}

model SatuSehatSetting {
  id                    Int       @id @default(1)
  environment           String    @default("staging")
  stgOrganizationId     String    @default("")
  stgClientId           String    @default("")
  stgClientSecret       String    @default("")
  stgAuthUrl            String    @default("")
  stgBaseUrl            String    @default("")
  prdOrganizationId     String    @default("")
  prdClientId           String    @default("")
  prdClientSecret       String    @default("")
  prdAuthUrl            String    @default("")
  prdBaseUrl            String    @default("")
  organizationId        String    @default("")
  clientId              String    @default("")
  clientSecret          String    @default("")
  authUrl               String    @default("")
  baseUrl               String    @default("")
  encounterUrl          String?
  conditionUrl          String?
  serviceRequestUrl     String?
  imagingStudyUrl       String?
  observationUrl        String?
  diagnosticReportUrl   String?
  compositionUrl        String?
  patientUrl            String?
  locationUrl           String?
  practitionerUrl       String?
  defaultPatientId      String?   @default("")
  defaultPractitionerId String?   @default("")
  patientIdSource       String?   @default("PatientID")
  isActive              Boolean   @default(true)
  updatedAt             DateTime  @updatedAt
  autoSyncEnabled       Boolean   @default(false)
  autoSyncFrequency     String    @default("DAILY")
  autoSyncTime          String    @default("23:00")
  lastAutoSyncAt        DateTime?
}

model SatuSehatResourceLog {
  id               String   @id @default(cuid())
  resourceType     String
  resourceId       String?
  accessionNumber  String?
  studyInstanceUid String?
  method           String   @default("POST")
  status           String
  responseCode     Int?
  responseBody     Json?
  environment      String
  createdAt        DateTime @default(now())
}

model ModalityConnection {
  id        String   @id @default(cuid())
  aeTitle   String
  ipAddress String
  event     String
  timestamp DateTime @default(now())
}

model RadiologyReport {
  id                String   @id @default(cuid())
  patientId         String
  studyInstanceUid  String
  studyDate         String?
  accessionNumber   String?
  patientName       String?
  patientSex        String?
  age               String?
  address           String?
  sender            String?
  diagnosis         String?
  soap              String?
  photoNum          String?
  examType          String?
  findings          String?
  conclusion        String?
  recommendation    String?
  measurementImages Json?
  selectedSeries    Json?
  reportDate        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Doctor/Practitioner
  doctorId          String?
  doctorName        String?   // Fallback if user is not linked
  doctor            User?     @relation("DoctorReports", fields: [doctorId], references: [id])

  @@unique([patientId, studyInstanceUid])
}
