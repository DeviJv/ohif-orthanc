generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  RADIOGRAPHER
  RADIOLOGIST
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  role          UserRole  @default(RADIOLOGIST)
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AppConfig {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model AiResult {
  studyInstanceUid String   @id
  modality         String
  conclusion       String
  findings         Json // Store the results dictionary/probabilities
  isUrgent         Boolean  @default(false)
  heatmapPath      String? // Optional path for visual Grad-CAM
  heatmapBase64    String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SatuSehatIntegration {
  accessionNumber  String    @id // Stable key — does not change on metadata edit
  studyInstanceUid String? // For reference only (may change on modify)
  satusehatId      String? // UUID from Kemenkes
  patientNik       String? // NIK used for this integration
  status           String    @default("PENDING") // SUCCESS, FAILED
  error            String?   @db.Text
  bundleResponse   Json? // Full response from SatuSehat
  syncedAt         DateTime? // Time of successful sync
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model SatuSehatWebhookLog {
  id               String   @id @default(cuid())
  studyInstanceUid String?
  patientName      String?
  status           String // SUCCESS, FAILED
  message          String?  @db.Text
  errorDetail      Json? // Detailed error from router
  rawPayload       Json? // Complete incoming JSON
  createdAt        DateTime @default(now())
}

model SatuSehatSetting {
  id             Int    @id @default(1)
  organizationId String @default("")
  clientId       String @default("")
  clientSecret   String @default("") @db.Text
  environment    String @default("staging") // staging, production

  // Global URLs
  authUrl String @default("") @db.Text
  baseUrl String @default("") @db.Text

  // Per-Resource URL Overrides (Optional)
  encounterUrl        String? @db.Text
  conditionUrl        String? @db.Text
  serviceRequestUrl   String? @db.Text
  imagingStudyUrl     String? @db.Text
  observationUrl      String? @db.Text
  diagnosticReportUrl String? @db.Text
  compositionUrl      String? @db.Text
  patientUrl          String? @db.Text
  locationUrl         String? @db.Text
  practitionerUrl     String? @db.Text

  // Default Personas (Dummy Data for Testing)
  defaultPatientId      String? @default("")
  defaultPractitionerId String? @default("")

  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}
